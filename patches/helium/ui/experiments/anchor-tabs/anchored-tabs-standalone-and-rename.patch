+void TabUIHelper::SetAnchored(bool anchored, bool persist) {
+  if (!features::IsHeliumAnchoredTabsEnabled()) {
+    return;
+  }
+
+  // Avoid redundant UI churn when nothing changed, but still allow an explicit
+  // (persist) call to re-write the durable value.
+  if (anchored_ == anchored && !persist) {
+    return;
+  }
+  anchored_ = anchored;
+
+  // When a tab is first anchored, remember its current URL as the anchor so the
+  // "return to anchor" affordance can detect later navigations away from it.
+  if (anchored_ && !anchored_url_.is_valid() && web_contents()) {
+    GURL url = web_contents()->GetLastCommittedURL();
+    if (!url.is_valid()) {
+      url = web_contents()->GetVisibleURL();
+    }
+    if (url.is_valid()) {
+      SetAnchoredURL(url, web_contents()->GetTitle(), persist);
+    }
+  }
+
+  // Push the change through the existing tab-state-changed plumbing so the tab
+  // strip re-partitions the tab above/below the anchored separator.
+  if (web_contents()) {
+    web_contents()->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);
+  }
+  tab_ui_change_callbacks_.Notify();
+
+  if (!persist || !web_contents()) {
+    return;
+  }
+
+  Profile* const profile =
+      Profile::FromBrowserContext(web_contents()->GetBrowserContext());
+  SessionService* const session_service =
+      profile ? SessionServiceFactory::GetForProfile(profile) : nullptr;
+  sessions::SessionTabHelper* const tab_helper =
+      sessions::SessionTabHelper::FromWebContents(web_contents());
+  if (!session_service || !tab_helper) {
+    return;
+  }
+
+  session_service->AddTabExtraData(tab_helper->window_id(),
+                                   tab_helper->session_id(), kAnchoredSessionKey,
+                                   anchored_ ? "1" : "0");
+}
+
+void TabUIHelper::RestoreAnchoredFromExtraData(
+    content::WebContents* web_contents,
+    const std::map<std::string, std::string>& extra_data) {
+  if (!features::IsHeliumAnchoredTabsEnabled() || !web_contents) {
+    return;
+  }
+
+  auto it = extra_data.find(kAnchoredSessionKey);
+  if (it == extra_data.end() || it->second != "1") {
+    return;
+  }
+
+  if (tabs::TabInterface* const tab_interface =
+          tabs::TabInterface::GetFromContents(web_contents)) {
+    if (TabUIHelper* const helper = TabUIHelper::From(tab_interface)) {
+      helper->SetAnchored(true, /*persist=*/false);
+    }
+  }
+}
