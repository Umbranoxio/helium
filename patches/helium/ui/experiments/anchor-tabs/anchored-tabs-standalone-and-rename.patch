+void VerticalUnpinnedTabContainerView::UpdateDragAnchorState(
+    const gfx::Rect& dragged_tab_bounds,
+    const views::ProposedLayout& layout) {
+  if (!features::IsHeliumAnchoredTabsEnabled()) {
+    drag_anchor_active_ = false;
+    return;
+  }
+
+  // The boundary between the anchored region and the regular tabs is the
+  // separator when it is shown, otherwise the "+ New Tab" row.
+  std::optional<int> boundary_y;
+  for (const auto& child_layout : layout.child_layouts) {
+    if (child_layout.child_view == grouped_tabs_separator_ &&
+        child_layout.visible) {
+      boundary_y = child_layout.bounds.y();
+      break;
+    }
+  }
+  if (!boundary_y.has_value()) {
+    for (const auto& child_layout : layout.child_layouts) {
+      if (child_layout.child_view == middle_pinned_view_ &&
+          child_layout.visible) {
+        boundary_y = child_layout.bounds.y();
+        break;
+      }
+    }
+  }
+  if (!boundary_y.has_value()) {
+    drag_anchor_active_ = false;
+    return;
+  }
+
+  drag_anchor_active_ = true;
+  drag_anchor_target_ =
+      dragged_tab_bounds.CenterPoint().y() < boundary_y.value();
+}
+
+void VerticalUnpinnedTabContainerView::FinalizeDragAnchorState(bool completed) {
+  const bool was_active = drag_anchor_active_;
+  drag_anchor_active_ = false;
+  // Only apply the anchored decision for a completed drop; a canceled/reverted
+  // drag must leave the tab's anchored state untouched.
+  if (!completed || !was_active || !features::IsHeliumAnchoredTabsEnabled()) {
+    return;
+  }
+
+  bool changed = false;
+  for (const views::View* dragging_view : GetDraggingViews()) {
+    auto* tab_view = views::AsViewClass<VerticalTabView>(
+        const_cast<views::View*>(dragging_view));
+    if (!tab_view) {
+      continue;
+    }
+    tabs::TabInterface* const tab =
+        const_cast<tabs::TabInterface*>(tab_view->GetTabInterface());
+    if (!tab) {
+      continue;
+    }
+    // Group membership already anchors a tab; only toggle the explicit flag for
+    // standalone tabs to avoid stale state on grouped tabs.
+    if (tab->GetGroup().has_value()) {
+      continue;
+    }
+    TabUIHelper* const helper = TabUIHelper::From(tab);
+    if (!helper || helper->anchored() == drag_anchor_target_) {
+      continue;
+    }
+    helper->SetAnchored(drag_anchor_target_);
+    changed = true;
+  }
+  if (changed) {
+    InvalidateLayout();
+  }
+}
