+bool VerticalTabView::MaybeStartInlineRename() {
+  if (!collection_node_) {
+    return false;
+  }
+  auto* controller = collection_node_->GetController();
+  if (!controller) {
+    return false;
+  }
+  TabStripModel* const model = controller->GetModel();
+  tabs::TabInterface* const tab =
+      const_cast<tabs::TabInterface*>(GetTabInterface());
+  if (!model || !tab) {
+    return false;
+  }
+  const int index = model->GetIndexOfTab(tab);
+  if (index < 0 || !helium::IsAnchoredTab(model, index)) {
+    return false;
+  }
+
+  content::WebContents* const contents = tab->GetContents();
+  TabUIHelper* const helper = TabUIHelper::From(tab);
+  if (!contents || !helper) {
+    return false;
+  }
+
+  base::WeakPtr<TabUIHelper> weak_helper = helper->GetWeakPtr();
+  helium::ShowTabRenameDialog(
+      contents, helper->GetTitle(),
+      base::BindOnce(
+          [](base::WeakPtr<TabUIHelper> h, std::u16string new_title) {
+            if (h) {
+              h->SetCustomTitle(std::move(new_title));
+            }
+          },
+          std::move(weak_helper)));
+  return true;
