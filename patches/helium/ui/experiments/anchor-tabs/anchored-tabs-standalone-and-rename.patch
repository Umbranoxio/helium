+bool VerticalTabView::MaybeStartInlineRename() {
+  if (!collection_node_) {
+    return false;
+  }
+  auto* controller = collection_node_->GetController();
+  if (!controller) {
+    return false;
+  }
+  TabStripModel* const model = controller->GetModel();
+  tabs::TabInterface* const tab =
+      const_cast<tabs::TabInterface*>(GetTabInterface());
+  if (!model || !tab) {
+    return false;
+  }
+  const int index = model->GetIndexOfTab(tab);
+  if (index < 0 || !helium::IsAnchorEligibleForUiFeatures(model, index)) {
+    return false;
+  }
+
+  BeginInlineRename();
+  return true;
+}
+
+void VerticalTabView::BeginInlineRename() {
+  if (rename_active_ || !rename_textfield_) {
+    return;
+  }
+  tabs::TabInterface* const tab =
+      const_cast<tabs::TabInterface*>(GetTabInterface());
+  TabUIHelper* const helper = tab ? TabUIHelper::From(tab) : nullptr;
+  if (!helper) {
+    return;
+  }
+
+  rename_active_ = true;
+  rename_textfield_->SetText(helper->GetTitle());
+  rename_textfield_->SetVisible(true);
+  InvalidateLayout();
+  rename_textfield_->RequestFocus();
+  rename_textfield_->SelectAll(/*reversed=*/false);
+}
+
+void VerticalTabView::CommitInlineRename() {
+  if (!rename_active_ || finishing_rename_) {
+    return;
+  }
+  finishing_rename_ = true;
+
+  std::u16string new_title(rename_textfield_ ? rename_textfield_->GetText()
+                                             : std::u16string_view());
+  if (tabs::TabInterface* const tab =
+          const_cast<tabs::TabInterface*>(GetTabInterface())) {
+    if (TabUIHelper* const helper = TabUIHelper::From(tab)) {
+      // Persisted via the session extra-data path so the custom name survives
+      // browser restarts.
+      helper->SetCustomTitle(std::move(new_title));
+    }
+  }
+
+  rename_active_ = false;
+  if (rename_textfield_) {
+    rename_textfield_->SetVisible(false);
+  }
+  finishing_rename_ = false;
+  InvalidateLayout();
+}
+
+void VerticalTabView::CancelInlineRename() {
+  if (!rename_active_ || finishing_rename_) {
+    return;
+  }
+  finishing_rename_ = true;
+  rename_active_ = false;
+  if (rename_textfield_) {
+    rename_textfield_->SetVisible(false);
+  }
+  finishing_rename_ = false;
+  InvalidateLayout();
+}
+
+bool VerticalTabView::HandleKeyEvent(views::Textfield* sender,
+                                     const ui::KeyEvent& key_event) {
+  if (sender != rename_textfield_ ||
+      key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (key_event.key_code() == ui::VKEY_RETURN) {
+    CommitInlineRename();
+    return true;
+  }
+  if (key_event.key_code() == ui::VKEY_ESCAPE) {
+    CancelInlineRename();
+    return true;
+  }
+  return false;
+}
+
+bool VerticalTabView::MaybeReturnToAnchorInsteadOfClose() {
+  if (!features::IsHeliumAnchoredTabsEnabled() || !collection_node_) {
+    return false;
+  }
+  auto* controller = collection_node_->GetController();
+  if (!controller) {
+    return false;
+  }
+  TabStripModel* const model = controller->GetModel();
+  tabs::TabInterface* const tab =
+      const_cast<tabs::TabInterface*>(GetTabInterface());
+  if (!model || !tab) {
+    return false;
+  }
+  const int index = model->GetIndexOfTab(tab);
+  if (index < 0 || !helium::IsAnchorEligibleForUiFeatures(model, index)) {
+    return false;
+  }
+  TabUIHelper* const helper = TabUIHelper::From(tab);
+  // Only return to a real, navigable anchor. A blank/NTP anchor (which may have
+  // been persisted by an older build) must never hijack the close: an empty new
+  // tab should just close.
+  if (!helper || !helper->anchored_url().is_valid() ||
+      IsBlankOrNewTabUrl(helper->anchored_url())) {
+    return false;
+  }
+  content::WebContents* const contents = tab->GetContents();
+  if (!contents) {
+    return false;
+  }
+  // Already at the anchor: let the close proceed normally.
+  if (contents->GetLastCommittedURL() == helper->anchored_url()) {
+    return false;
+  }
+  contents->GetController().LoadURL(helper->anchored_url(), content::Referrer(),
+                                    ui::PAGE_TRANSITION_AUTO_BOOKMARK,
+                                    std::string());
+  return true;
+}
+
+void VerticalTabView::MaybeCaptureAnchorUrl(tabs::TabInterface* tab,
+                                            int model_index) {
+  if (!features::IsHeliumAnchoredTabsEnabled() || !tab || !collection_node_ ||
+      !collection_node_->GetController()) {
+    return;
+  }
+  TabStripModel* const model = collection_node_->GetController()->GetModel();
+  if (!model || !helium::IsAnchorEligibleForUiFeatures(model, model_index)) {
+    return;
+  }
+  TabUIHelper* const helper = TabUIHelper::From(tab);
+  if (!helper || helper->anchored_url().is_valid()) {
+    return;
+  }
+  content::WebContents* const contents = tab->GetContents();
+  if (!contents) {
+    return;
+  }
+  const GURL url = contents->GetLastCommittedURL();
+  // Don't anchor an empty new tab (blank/NTP). It only becomes anchored once it
+  // has real content, so an empty grouped new tab still closes normally.
+  if (url.is_valid() && !IsBlankOrNewTabUrl(url)) {
+    helper->SetAnchoredURL(url, contents->GetTitle());
+  }
+}
+
+bool VerticalTabView::ShouldShowAnchorReturnIndicator() const {
+  if (!features::IsHeliumAnchoredTabsEnabled() || collapsed_ ||
+      tab_data_.is_tab_discarded) {
+    return false;
+  }
+  const tabs::TabInterface* const tab_interface = GetTabInterface();
+  if (!tab_interface) {
+    return false;
+  }
+  const TabUIHelper* const helper = TabUIHelper::From(tab_interface);
+  if (!helper || !helper->anchored_url().is_valid() ||
+      IsBlankOrNewTabUrl(helper->anchored_url())) {
+    return false;
+  }
+  // Show the "return to anchor" affordance only once the tab has navigated
+  // away from its original anchored URL.
+  return tab_data_.last_committed_url.is_valid() &&
+         tab_data_.last_committed_url != helper->anchored_url();
+}
+
+void VerticalTabView::OnTabUiHelperChanged() {
+  if (collection_node_) {
+    OnDataChanged();
+  }
+}
