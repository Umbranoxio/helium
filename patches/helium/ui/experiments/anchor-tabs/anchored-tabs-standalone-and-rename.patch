+base::flat_set<const content::WebContents*> GetTopRecentlyActiveContents(
+    const TabStripModel* model,
+    size_t top_n) {
+  base::flat_set<const content::WebContents*> result;
+  if (!model || top_n == 0) {
+    return result;
+  }
+
+  std::vector<std::pair<base::TimeTicks, content::WebContents*>> entries;
+  entries.reserve(model->count());
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* const contents = model->GetWebContentsAt(i);
+    if (!contents) {
+      continue;
+    }
+    entries.emplace_back(contents->GetLastActiveTimeTicks(), contents);
+  }
+  std::stable_sort(
+      entries.begin(), entries.end(),
+      [](const auto& a, const auto& b) { return a.first > b.first; });
+
+  const size_t limit = std::min(top_n, entries.size());
+  for (size_t i = 0; i < limit; ++i) {
+    result.insert(entries[i].second);
+  }
+  return result;
+}
