+
+void VerticalTabGroupView::ScheduleHibernateTabsOutsideTopRecent() {
+  if (hibernate_scheduled_) {
+    return;
+  }
+  hibernate_scheduled_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&VerticalTabGroupView::HibernateTabsOutsideTopRecent,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void VerticalTabGroupView::HibernateTabsOutsideTopRecent() {
+  hibernate_scheduled_ = false;
+  if (!collection_node_ || !IsCollapsed() ||
+      !collection_node_->GetController()) {
+    return;
+  }
+  TabStripModel* const model = collection_node_->GetController()->GetModel();
+  if (!model) {
+    return;
+  }
+  helium::HibernateGroupTabsOutsideTopRecent(
+      model, GetTabGroupFromNode(collection_node_)->id(),
+      kMaxRecentVisibleTabs);
 }
 
